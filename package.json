							"エージェントタブを起動時に表示",
							"メモリタブを起動時に表示",
							"プロジェクトタブを起動時に表示"
						],
						"description": "メインビューを開いた際のデフォルトタブ"
					}
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"vscode:uninstall": "node ./out/uninstall.js",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && node --test test/unit/*.test.js"
	},
	"repository": {
		"type": "git",
