							"graph",
							"tree",
							"group"
						],
						"enumDescriptions": [
							"Obsidian 風力学グラフ（既定・宇宙感の Canvas ダーク UI）",
							"カード階層（VS Code テーマ追従・共有向き）",
							"グループ（部署別 / モデル別 / 稼働状態別のチップ切替）"
						],
						"description": "組織図の起動時のサブモードです（v0.5.23 追加）"
					},
					"claudeManager.orgChart.hideOtherProjects": {
						"type": "boolean",
						"default": false,
						"description": "組織図で現ワークスペース外のエージェントを非表示にします。既定は減光のみ（v0.5.23 追加）"
					},
					"claudeManager.orgChart.showGlobal": {
						"type": "boolean",
						"default": false,
						"description": "組織図にグローバルエージェント（parentAgent が未設定で `showInOrgChart` も指定なしのもの）も含めます。既定 OFF で部門所属エージェントのみ表示（v0.5.26 追加）。ツールバーの『グローバルも表示』トグルからも切替可能"
					},
					"claudeManager.orgChart.defaultRoot": {
						"type": "string",
						"default": "",
						"description": "組織図の起動時ルート絞り込み（そのルート配下のみを表示）。空文字＝『すべて』。ツールバーの『ルート』セレクタで切り替えると自動で永続化されます（v0.5.26 追加）"
					},
					"claudeManager.agent.openInNewWindowWhenFolderMismatch": {
						"type": "boolean",
						"default": true,
						"description": "『Claudeで開く』のとき、セッション作成時 cwd（または agent.workDir）が現在のワークスペース外にあれば、対象フォルダを新しい VS Code ウィンドウで開いてからセッション復元を試みます。OFF にすると従来の警告メッセージのみ（v0.5.27 追加）"
					},
					"claudeManager.agents.defaultExpand": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [
							"bookmarks",
							"recent"
						],
						"description": "エージェントタブで起動時に展開するセクション（`bookmarks` / `recent` / `global` / `project`）です"
					},
					"claudeManager.agents.expandMode": {
						"type": "string",
						"default": "active-branches",
						"enum": [
							"all",
							"active-branches",
							"top-level"
						],
						"enumDescriptions": [
							"すべて展開",
							"稼働中の枝のみ展開（既定）",
							"トップレベルのみ展開（子を折り畳む）"
						],
						"description": "エージェント一覧の起動時の展開状態です（v0.5.18 追加）"
					},
					"claudeManager.agents.activeOnly": {
						"type": "boolean",
						"default": false,
						"description": "エージェント一覧・ライブ状態ビューで稼働中のエージェントのみを表示するフィルタです。ツールバーの $(filter) アイコンから切替できます（v0.5.18 追加）"
					},
					"claudeManager.agents.defaultGroupMode": {
						"type": "string",
						"default": "org",
						"enum": [
							"org",
							"model",
							"status",
							"flat"
						],
						"enumDescriptions": [
							"組織図（現行の親子関係でグルーピング）",
							"モデル別（Fable / Opus / Sonnet / Haiku …）",
							"状態別（稼働中 / 待機 / 未紐づけ）",
							"フラット（グルーピングなし・名前順）"
						],
						"description": "エージェント一覧のグルーピング方式です（v0.5.18 追加）"
					},
					"claudeManager.useNewMainPanel": {
						"type": "boolean",
						"default": true,
						"description": "v0.5.0 で追加した新しいプロジェクトタブ UI（`claudeMain`）を使用します。OFF にすると旧 5 TreeView（会話一覧 / ブックマーク / タグ / エージェント管理 / メモリ管理）に戻ります。変更後は VS Code を再起動してください"
					},
					"claudeManager.locale": {
						"type": "string",
						"default": "ja",
						"enum": [
							"ja",
							"en"
						],
						"enumDescriptions": [
							"日本語",
							"English"
						],
						"description": "UI の表示言語です。変更後は VS Code を再起動してください"
					},
					"claudeManager.locale.autoTranslate": {
						"type": "boolean",
						"default": false,
						"description": "エージェント定義の未翻訳テキストを Anthropic API で自動翻訳します（API キーが必要）"
					},
					"claudeManager.ui.defaultTab": {
						"type": "string",
						"default": "sessions",
						"enum": [
							"sessions",
							"agents",
							"memory",
							"projects"
						],
						"enumDescriptions": [
							"起動時にセッションタブを表示します",
							"起動時にエージェントタブを表示します",
							"起動時にメモリタブを表示します",
							"起動時にプロジェクトタブを表示します"
						],
						"description": "メインビューを開いた際に最初に表示するタブ（既定）です"
					}
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"vscode:uninstall": "node ./out/uninstall.js",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && node --test test/unit/*.test.js"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ratorin/claude-session-manager.git"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.85.0",
		"typescript": "^5.3.0"
	}
}
