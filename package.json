			"view/item/context": [
				{
					"command": "claudeManager.previewSession",
					"when": "view == claudeSessions && viewItem =~ /^session/",
					"group": "inline"
				},
				{
					"command": "claudeManager.bookmarkSession",
					"when": "view == claudeSessions && (viewItem == session || viewItem == sessionRegistered)",
					"group": "inline"
				},
				{
					"command": "claudeManager.openInClaude",
					"when": "viewItem =~ /^session/",
					"group": "0_open@1"
				},
				{
					"command": "claudeManager.copySessionId",
					"when": "viewItem =~ /^session/",
					"group": "0_open@3"
				},
				{
					"command": "claudeManager.copySessionPath",
					"when": "viewItem =~ /^session/",
					"group": "0_open@4"
				},
				{
					"command": "claudeManager.renameSession",
					"when": "viewItem =~ /^session/",
					"group": "1_edit@1"
				},
				{
					"command": "claudeManager.tagSession",
					"when": "viewItem =~ /^session/",
					"group": "1_edit@2"
				},
				{
					"command": "claudeManager.registerAgent",
					"when": "viewItem == session || viewItem == sessionBookmarked",
					"group": "2_link@1"
				},
				{
					"command": "claudeManager.editAgent",
					"when": "viewItem == sessionRegistered || viewItem == sessionRegisteredBookmarked",
					"group": "2_link@2"
				},
				{
					"command": "claudeManager.editRuleFile",
					"when": "viewItem == sessionRegistered || viewItem == sessionRegisteredBookmarked",
					"group": "2_link@3"
				},
				{
					"command": "claudeManager.deleteSession",
					"when": "viewItem =~ /^session/",
					"group": "3_danger@1"
				},
				{
					"command": "claudeManager.unbookmarkSession",
					"when": "view == claudeBookmarks && viewItem =~ /Bookmarked/",
					"group": "inline"
				},
				{
					"command": "claudeManager.previewSession",
					"when": "view == claudeBookmarks && viewItem =~ /Bookmarked/",
					"group": "inline"
				},
				{
					"command": "claudeManager.removeTag",
					"when": "view == claudeTags && viewItem == taggedSession",
					"group": "inline"
				},
				{
					"command": "claudeManager.addAgentFavorite",
					"when": "view == claudeAgents && viewItem =~ /^agentItem/ && !(viewItem =~ /Bookmarked/)",
					"group": "inline"
				},
				{
					"command": "claudeManager.removeAgentFavorite",
					"when": "(view == claudeAgents || view == claudeAgentsFavorites) && (viewItem =~ /^agentItem.*Bookmarked/ || viewItem =~ /^favoriteAgent/)",
					"group": "inline"
				},
				{
					"command": "claudeManager.previewAgent",
					"when": "(view == claudeAgents || view == claudeAgentsFavorites) && viewItem =~ /(agentItemLinked|favoriteAgentLinked)/",
					"group": "0_open@1"
				},
				{
					"command": "claudeManager.openAgentInClaude",
					"when": "(view == claudeAgents || view == claudeAgentsFavorites) && viewItem =~ /(agentItemLinked|favoriteAgentLinked)/",
					"group": "0_open@2"
				},
				{
					"command": "claudeManager.openAgentSession",
					"when": "(view == claudeAgents || view == claudeAgentsFavorites) && viewItem =~ /(agentItemLinked|favoriteAgentLinked)/",
					"group": "0_open@3"
				},
				{
					"command": "claudeManager.renewAgentSession",
					"when": "view == claudeAgents && viewItem =~ /agentItemLinked/",
					"group": "0_open@4"
				},
				{
					"command": "claudeManager.copyAgentSessionId",
					"when": "view == claudeAgents && viewItem =~ /agentItemLinked/",
					"group": "0_open@5"
				},
				{
					"command": "claudeManager.copyAgentSessionPath",
					"when": "view == claudeAgents && viewItem =~ /agentItemLinked/",
					"group": "0_open@6"
				},
				{
					"command": "claudeManager.editAgent",
					"when": "view == claudeAgents && viewItem =~ /^agentItem/",
					"group": "1_edit@1"
				},
				{
					"command": "claudeManager.linkSession",
					"when": "view == claudeAgents && viewItem =~ /^agentItem/",
					"group": "2_link@1"
				},
				{
					"command": "claudeManager.deleteAgent",
					"when": "view == claudeAgents && viewItem =~ /^agentItem/",
					"group": "3_danger@1"
				},
				{
					"command": "claudeManager.previewMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "inline"
				},
				{
					"command": "claudeManager.copyMemoryPath",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "0_copy"
				},
				{
					"command": "claudeManager.editMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "1_edit"
				},
				{
					"command": "claudeManager.mergeMemories",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "2_actions"
				},
				{
					"command": "claudeManager.extractMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "2_actions"
				},
				{
					"command": "claudeManager.deleteMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "3_danger"
				},
				{
					"command": "claudeManager.openProjectInVSC",
					"when": "view == claudeMemory && viewItem == memoryProject",
					"group": "0_open"
				},
				{
					"command": "claudeManager.openOrchestrationSessionInClaude",
					"when": "view == claudeOrchestration && viewItem =~ /^orchestrationSession/",
					"group": "inline"
				},
				{
					"command": "claudeManager.copyOrchestrationSessionId",
					"when": "view == claudeOrchestration && viewItem =~ /^orchestrationSession/",
					"group": "1_copy"
				},
				{
					"command": "claudeManager.openOrchestrationSessionInClaude",
					"when": "view == claudeOrchestration && viewItem =~ /^orchestrationSession/",
					"group": "0_open"
				}
			]
		},
		"configuration": [
			{
				"title": "エージェント監視",
				"order": 1,
				"properties": {
					"claudeManager.enableAgentMonitor": {
						"type": "boolean",
						"default": true,
						"order": 2,
						"markdownDescription": "エージェント監視を有効にします。ON にするとステータスバーに稼働中エージェントをリアルタイム表示します。\n\n⚠️ **有効にすると PC 負荷が若干上がります**（定期的なセッション状態チェックのため）"
					},
					"claudeManager.agentMonitorInterval": {
						"type": "number",
						"default": 5,
						"minimum": 1,
						"maximum": 60,
						"order": 2,
						"markdownDescription": "エージェント監視の更新間隔（秒）。`#claudeManager.enableAgentMonitor#` が有効のときに使用されます。\n\n短くするとリアルタイム性が上がりますが、PC負荷も高まります"
					},
					"claudeManager.enableNotifications": {
						"type": "boolean",
						"default": true,
						"order": 3,
						"description": "タスク完了・エラー・停止時に VS Code の通知を表示します"
					},
					"claudeManager.taskStalledThreshold": {
						"type": "number",
						"default": 60,
						"minimum": 10,
						"maximum": 600,
						"order": 4,
						"description": "応答停止（stalled）判定の閾値（秒）。この時間セッションが更新されないと停止扱いになります"
					},
					"claudeManager.taskErrorThreshold": {
						"type": "number",
						"default": 1800,
						"minimum": 60,
						"maximum": 7200,
						"order": 4,
						"description": "エラー判定の閾値（秒）。対話セッションの無操作を誤検知しないよう既定は 30 分。サブエージェント専用に縮めたい場合は 600 秒などに調整してください"
					},
					"claudeManager.taskAutoCleanupHours": {
						"type": "number",
						"default": 72,
						"minimum": 1,
						"maximum": 720,
						"order": 5,
						"description": "完了・エラーのタスクログを自動削除するまでの時間（時間単位）"
					},
					"claudeManager.taskMaxLogs": {
						"type": "number",
						"default": 100,
						"minimum": 10,
						"maximum": 500,
						"order": 6,
						"description": "保持するタスクログの最大件数です"
					},
					"claudeManager.enableUsageMonitor": {
						"type": "boolean",
						"default": true,
						"order": 7,
						"markdownDescription": "Claude Code の利用制限をステータスバーに表示します。\n\n⚠️ 有効にすると Anthropic API への軽量リクエストが定期的に発生します（更新間隔に応じてコスト発生、月額 $0.01 未満）"
					},
					"claudeManager.usageMonitorInterval": {
						"type": "number",
						"default": 300,
						"minimum": 60,
						"maximum": 3600,
						"order": 8,
						"markdownDescription": "利用制限モニターの更新間隔（秒）。`#claudeManager.enableUsageMonitor#` が有効のときに使用されます"
					},
					"claudeManager.usage.show5dColumns": {
						"type": "boolean",
						"default": true,
						"order": 9,
						"description": "ステータスバーに Sonnet 5日 / Opus 5日 の利用率列を表示します（`S xx% / O xx%` 形式）。OFF にすると従来どおり 5h / 7d の表示のみになります"
					},
					"claudeManager.usage.statusBarStyle": {
						"type": "string",
						"default": "full",
						"enum": [
							"full",
							"compact",
							"max-only"
						],
						"enumDescriptions": [
							"フル表示（5h ・ 7d ・ Sonnet 5d ・ Opus 5d をパーセントとリセット時刻付きで表示します）",
							"コンパクト表示（リセット時刻を省略し、パーセントのみ表示します）",
							"最逼迫のみ表示（もっとも利用率が高い 1 枠のみ表示します）"
						],
						"order": 9,
						"markdownDescription": "ステータスバーの利用率表示のスタイルです。\n\n- **full**: `5% 4.5h / 7% 7d / S 3% 5d20h / O 20% 5d10h`\n- **compact**: `5% / 7% / S 3% / O 20%`\n- **max-only**: 最逼迫の枠のみ `O 20% 5d10h`\n\n詳細は常にツールチップと利用率メニュー（ステータスバークリック）から参照できます。"
					},
					"claudeManager.hooks.desktopNotification.enabled": {
						"type": "boolean",
						"default": false,
						"order": 10,
						"markdownDescription": "セッション終了時にターミナルベル（`\\u0007`）を発火してデスクトップ通知を行います。\n\n**Claude Code 2.1.141 以降** の `terminalSequence` 機能を利用します。あわせてターミナルエミュレーター側の通知設定も有効にしてください。\n\n既定は OFF（オプトイン）です。"
					}
				}
