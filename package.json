{
	"name": "claude-session-manager",
	"displayName": "Claude Session Manager — 会話履歴・エージェント運用",
	"description": "Claude Code の会話履歴・メモリ・マルチエージェント運用を管理する VS Code 拡張機能。ブックマーク、タグ、検索、組織図、大容量セッションの高速ビューワー、利用制限モニターに対応。",
	"version": "0.5.27",
	"publisher": "ratorin",
	"engines": {
		"vscode": "^1.85.0"
	},
	"icon": "images/icon.png",
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "claude-sessions",
					"title": "💬 セッション",
					"icon": "$(comment-discussion)"
				},
				{
					"id": "claude-agents",
					"title": "👤 エージェント",
					"icon": "$(organization)"
				},
				{
					"id": "claude-memory",
					"title": "🧠 メモリ",
					"icon": "$(database)"
				},
				{
					"id": "claude-projects",
					"title": "📁 プロジェクト",
					"icon": "$(folder-opened)"
				}
			],
			"panel": [
				{
					"id": "claude-help",
					"title": "Claude Help",
					"icon": "$(question)"
				}
			]
		},
		"views": {
			"claude-sessions": [
				{
					"id": "claudeBookmarks",
					"name": "会話ブックマーク",
					"icon": "$(star-full)"
				},
				{
					"id": "claudeTags",
					"name": "会話タグ",
					"icon": "$(tag)"
				},
				{
					"id": "claudeSessions",
					"name": "会話一覧",
					"icon": "$(comment-discussion)"
				}
			],
			"claude-agents": [
				{
					"id": "claudeAgentsLive",
					"name": "ライブ状態",
					"icon": "$(pulse)"
				},
				{
					"id": "claudeAgentsFavorites",
					"name": "お気に入り",
					"icon": "$(star-full)"
				},
				{
					"id": "claudeAgents",
					"name": "エージェント管理",
					"icon": "$(person)"
				},
				{
					"id": "claudeOrchestration",
					"name": "🎼 オーケストレーション",
					"icon": "$(circuit-board)"
				}
			],
			"claude-memory": [
				{
					"id": "claudeMemory",
					"name": "メモリ管理",
					"icon": "$(database)"
				}
			],
			"claude-projects": [
				{
					"type": "webview",
					"id": "claudeMain",
					"name": "プロジェクト",
					"icon": "$(folder-opened)"
				}
			],
			"claude-help": [
				{
					"id": "claudeHelp",
					"name": "ヘルプ & フィードバック",
					"icon": "$(question)"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "claudeAgents",
				"contents": "エージェントが未登録です。\nまずは取締役を登録して、マルチエージェント運用を始めましょう。\n[取締役を登録](command:claudeManager.registerDirector)\n[使い方ガイドを開く](command:claudeManager.openGuide)\n\n初めて使う場合は [Get Started ウォークスルー](command:workbench.action.openWalkthrough?%22ratorin.claude-session-manager%23csmGettingStarted%22) がおすすめです。",
				"when": "!claudeManager.hasAgents"
			},
			{
				"view": "claudeAgentsFavorites",
				"contents": "お気に入りエージェントがありません。\nエージェントリストで ☆ をクリックして追加しましょう。",
				"when": "claudeManager.hasAgents"
			},
			{
				"view": "claudeSessions",
				"contents": "セッションがまだありません。\nClaude Code で会話を始めるとここに表示されます。\n\n[使い方ガイドを開く](command:claudeManager.openGuide)"
			},
			{
				"view": "claudeMemory",
				"contents": "メモリファイルがありません。\n`~/.claude/CLAUDE.md` や `<workspace>/.claude/CLAUDE.md` を作成すると Claude が起動時に読み込みます。\n\n[使い方ガイドを開く](command:claudeManager.openGuide)"
			},
			{
				"view": "claudeOrchestration",
				"contents": "稼働中のセッションがありません。\nエージェント監視を有効にすると、ここでライブ状況を可視化できます。\n\n[エージェント監視を有効化](command:claudeManager.enableAgentMonitor)\n[使い方ガイドを開く](command:claudeManager.openGuide)"
			}
		],
		"walkthroughs": [
			{
				"id": "csmGettingStarted",
				"title": "Claude Session Manager をはじめる",
				"description": "5 ステップで CSM のマルチエージェント運用を立ち上げます。",
				"steps": [
					{
						"id": "checkClaudeCode",
						"title": "① Claude Code の確認",
						"description": "Claude Code 拡張と CLI がインストールされていることを確認します。\n[Claude Code パネルを開く](command:claudeManager.openUsageMenu)",
						"media": {
							"markdown": "media/walkthrough/step1.md"
						},
						"completionEvents": [
							"onCommand:claudeManager.openUsageMenu"
						]
					},
					{
						"id": "registerDirector",
						"title": "② 取締役を登録",
						"description": "組織のトップに位置する『取締役』エージェントを登録します。プリセットから開始できます。\n[取締役を登録](command:claudeManager.registerDirector)",
						"media": {
							"markdown": "media/walkthrough/step2.md"
						},
						"completionEvents": [
							"onCommand:claudeManager.registerDirector",
							"onContext:claudeManager.hasAgents"
						]
					},
					{
						"id": "installAskAgent",
						"title": "③ /csm-ask-agent スキルをインストール",
						"description": "Claude 内から子エージェントに指示を送るためのスキルをインストールします。\n[/csm-ask-agent をインストール](command:claudeManager.installCsmAskAgent)",
						"media": {
							"markdown": "media/walkthrough/step3.md"
						},
						"completionEvents": [
							"onCommand:claudeManager.installCsmAskAgent"
						]
					},
					{
						"id": "enableMonitor",
						"title": "④ エージェント監視を有効化",
						"description": "ライブ状態やモデル不一致を検知するために監視を有効にします。\n[エージェント監視を有効化](command:claudeManager.enableAgentMonitor)",
						"media": {
							"markdown": "media/walkthrough/step4.md"
						},
						"completionEvents": [
							"onCommand:claudeManager.enableAgentMonitor",
							"onSettingChanged:claudeManager.enableAgentMonitor"
						]
					},
					{
						"id": "openOrgChart",
						"title": "⑤ 組織図を開いて確認",
						"description": "エージェントの親子関係を組織図で確認しましょう。\n[組織図を開く](command:claudeManager.openOrgChart)",
						"media": {
							"markdown": "media/walkthrough/step5.md"
						},
						"completionEvents": [
							"onCommand:claudeManager.openOrgChart"
						]
					}
				]
			}
		],
		"commands": [
			{
				"command": "claudeManager.removeAllHooks",
				"title": "すべての CSM フックを削除（アンインストール準備）",
				"icon": "$(trash)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.refreshSessions",
				"title": "会話一覧を更新",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.previewSession",
				"title": "会話をプレビュー",
				"icon": "$(eye)",
				"category": "Claude Session Manager"
			},
			{
