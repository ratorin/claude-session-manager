{
	"name": "claude-session-manager",
	"displayName": "Claude Session Manager - セッション履歴管理",
	"description": "Claude Codeの会話履歴・メモリを管理するVS Code拡張機能",
	"version": "0.3.1",
	"publisher": "ratorin",
	"engines": {
		"vscode": "^1.85.0"
	},
	"icon": "images/icon.png",
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "claude-manager",
					"title": "Claude Session Manager",
					"icon": "$(comment-discussion)"
				}
			]
		},
		"views": {
			"claude-manager": [
				{
					"id": "claudeSessions",
					"name": "会話一覧（セッション）",
					"icon": "$(comment-discussion)"
				},
				{
					"id": "claudeBookmarks",
					"name": "会話ブックマーク",
					"icon": "$(star-full)"
				},
				{
					"id": "claudeTags",
					"name": "会話タグ",
					"icon": "$(tag)"
				},
				{
					"id": "claudeAgents",
					"name": "エージェント管理",
					"icon": "$(person)"
				},
				{
					"id": "claudeMemory",
					"name": "メモリ管理",
					"icon": "$(database)"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "claudeAgents",
				"contents": "エージェントが未登録です。\nまずは取締役を登録して、マルチエージェント運用を始めましょう。\n[取締役を登録](command:claudeManager.registerDirector)\n[使い方ガイドを開く](command:claudeManager.openGuide)",
				"when": "!claudeManager.hasAgents"
			}
		],
		"commands": [
			{
				"command": "claudeManager.refreshSessions",
				"title": "会話一覧を更新",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.previewSession",
				"title": "会話をプレビュー",
				"icon": "$(eye)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.bookmarkSession",
				"title": "ブックマークに追加",
				"icon": "$(star-empty)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.unbookmarkSession",
				"title": "ブックマークから削除",
				"icon": "$(star-full)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.tagSession",
				"title": "タグを追加",
				"icon": "$(tag)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.removeTag",
				"title": "タグを削除",
				"icon": "$(close)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.renameSession",
				"title": "会話をリネーム",
				"icon": "$(edit)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.searchSessions",
				"title": "会話を検索",
				"icon": "$(search)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.refreshMemory",
				"title": "メモリを更新",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.previewMemory",
				"title": "メモリをプレビュー",
				"icon": "$(eye)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.mergeMemories",
				"title": "メモリを統合",
				"icon": "$(merge)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.extractMemory",
				"title": "メモリから抽出",
				"icon": "$(split-horizontal)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.deleteMemory",
				"title": "メモリを削除",
				"icon": "$(trash)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.editMemory",
				"title": "メモリを編集",
				"icon": "$(edit)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.copySessionId",
				"title": "セッションIDをコピー",
				"icon": "$(copy)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.previewAgent",
				"title": "エージェントプレビュー",
				"icon": "$(eye)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.registerAgent",
				"title": "エージェントとして登録",
				"icon": "$(person-add)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.editAgent",
				"title": "エージェント設定を編集",
				"icon": "$(edit)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.editRuleFile",
				"title": "ルールファイルを編集",
				"icon": "$(file-code)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.linkSession",
				"title": "セッションを紐づけ",
				"icon": "$(link)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openAgentSession",
				"title": "セッションを開く",
				"icon": "$(terminal)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.renewAgentSession",
				"title": "セッションを新しくする",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.deleteAgent",
				"title": "エージェントを削除",
				"icon": "$(trash)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.refreshAgents",
				"title": "エージェント管理を更新",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openInClaude",
				"title": "Claude Codeで開く",
				"icon": {
					"light": "resources/sparkle-light.svg",
					"dark": "resources/sparkle-dark.svg"
				},
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openOrgChart",
				"title": "組織図を開く",
				"icon": "$(organization)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openGuide",
				"title": "使い方ガイドを開く",
				"icon": "$(book)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.copySessionPath",
				"title": "セッションパスをコピー",
				"icon": "$(file-symlink-file)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.copyMemoryPath",
				"title": "メモリパスをコピー",
				"icon": "$(file-symlink-file)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.deleteSession",
				"title": "セッションを削除",
				"icon": "$(trash)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.sortSessions",
				"title": "ソート",
				"icon": "$(arrow-swap)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.groupSessions",
				"title": "グループ切替",
				"icon": "$(list-tree)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.registerDirector",
				"title": "取締役を登録",
				"icon": "$(person-add)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.addAgent",
				"title": "エージェントを追加",
				"icon": "$(add)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openSettings",
				"title": "設定を開く",
				"icon": "$(gear)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.toggleSessionFilter",
				"title": "プロジェクト/全て切替",
				"icon": "$(filter)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openProjectInVSC",
				"title": "VS Codeで開く",
				"icon": "$(folder-opened)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openSettingsFile",
				"title": "設定ファイルを開く",
				"icon": "$(gear)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.refreshUsage",
				"title": "利用制限を更新",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.toggleBookmarkFilter",
				"title": "プロジェクト/全て切替",
				"icon": "$(filter)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.toggleMemoryFilter",
				"title": "プロジェクト/全て切替",
				"icon": "$(filter)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.migrateToFolderStructure",
				"title": "フォルダ構造に移行",
				"icon": "$(folder)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.migrateRuleFiles",
				"title": "ルールファイルを一括移行（YAML + フォルダ構造）",
				"icon": "$(arrow-up)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.syncAllParentRules",
				"title": "配下エージェント情報を一括再生成",
				"icon": "$(sync)",
				"category": "Claude Session Manager"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "claudeManager.refreshSessions",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.searchSessions",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.sortSessions",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.groupSessions",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.openOrgChart",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.openGuide",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.toggleSessionFilter",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.openSettings",
					"when": "view == claudeSessions",
					"group": "navigation@999"
				},
				{
					"command": "claudeManager.toggleBookmarkFilter",
					"when": "view == claudeBookmarks",
					"group": "navigation"
				},
				{
					"command": "claudeManager.toggleMemoryFilter",
					"when": "view == claudeMemory",
					"group": "navigation"
				},
				{
					"command": "claudeManager.refreshMemory",
					"when": "view == claudeMemory",
					"group": "navigation"
				},
				{
					"command": "claudeManager.addAgent",
					"when": "view == claudeAgents",
					"group": "navigation"
				},
					{
					"command": "claudeManager.refreshAgents",
					"when": "view == claudeAgents",
					"group": "navigation"
				},
				{
					"command": "claudeManager.openOrgChart",
					"when": "view == claudeAgents",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "claudeManager.previewSession",
					"when": "view == claudeSessions && viewItem =~ /^session/",
					"group": "inline"
				},
				{
					"command": "claudeManager.bookmarkSession",
					"when": "view == claudeSessions && (viewItem == session || viewItem == sessionRegistered)",
					"group": "inline"
				},
				{
					"command": "claudeManager.openInClaude",
					"when": "viewItem =~ /^session/",
					"group": "0_open"
				},
				{
					"command": "claudeManager.copySessionId",
					"when": "viewItem =~ /^session/",
					"group": "0_open"
				},
				{
					"command": "claudeManager.copySessionPath",
					"when": "viewItem =~ /^session/",
					"group": "0_open"
				},
				{
					"command": "claudeManager.renameSession",
					"when": "viewItem =~ /^session/",
					"group": "1_edit"
				},
				{
					"command": "claudeManager.tagSession",
					"when": "viewItem =~ /^session/",
					"group": "1_edit"
				},
				{
					"command": "claudeManager.registerAgent",
					"when": "viewItem == session || viewItem == sessionBookmarked",
					"group": "2_agent"
				},
				{
					"command": "claudeManager.editAgent",
					"when": "viewItem == sessionRegistered || viewItem == sessionRegisteredBookmarked",
					"group": "2_agent"
				},
				{
					"command": "claudeManager.editRuleFile",
					"when": "viewItem == sessionRegistered || viewItem == sessionRegisteredBookmarked",
					"group": "2_agent"
				},
				{
					"command": "claudeManager.deleteSession",
					"when": "viewItem =~ /^session/",
					"group": "3_danger"
				},
				{
					"command": "claudeManager.unbookmarkSession",
					"when": "view == claudeBookmarks && viewItem =~ /Bookmarked/",
					"group": "inline"
				},
				{
					"command": "claudeManager.previewSession",
					"when": "view == claudeBookmarks && viewItem =~ /Bookmarked/",
					"group": "inline"
				},
				{
					"command": "claudeManager.removeTag",
					"when": "view == claudeTags && viewItem == taggedSession",
					"group": "inline"
				},
				{
					"command": "claudeManager.openAgentSession",
					"when": "view == claudeAgents && viewItem =~ /agentItemLinked/",
					"group": "0_open"
				},
				{
					"command": "claudeManager.renewAgentSession",
					"when": "view == claudeAgents && viewItem =~ /agentItemLinked/",
					"group": "0_open"
				},
				{
					"command": "claudeManager.linkSession",
					"when": "view == claudeAgents && viewItem =~ /^agentItem/",
					"group": "0_link"
				},
				{
					"command": "claudeManager.editAgent",
					"when": "view == claudeAgents && viewItem =~ /^agentItem/",
					"group": "1_edit"
				},
				{
					"command": "claudeManager.editRuleFile",
					"when": "view == claudeAgents && viewItem =~ /WithRule/",
					"group": "1_edit"
				},
				{
					"command": "claudeManager.deleteAgent",
					"when": "view == claudeAgents && viewItem =~ /^agentItem/",
					"group": "3_danger"
				},
				{
					"command": "claudeManager.previewMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "inline"
				},
				{
					"command": "claudeManager.copyMemoryPath",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "0_copy"
				},
				{
					"command": "claudeManager.editMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "1_edit"
				},
				{
					"command": "claudeManager.mergeMemories",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "2_actions"
				},
				{
					"command": "claudeManager.extractMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "2_actions"
				},
				{
					"command": "claudeManager.deleteMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "3_danger"
				},
				{
					"command": "claudeManager.openProjectInVSC",
					"when": "view == claudeMemory && viewItem == memoryProject",
					"group": "0_open"
				}
			]
		},
		"configuration": [
			{
				"title": "エージェント監視",
				"order": 1,
				"properties": {
					"claudeManager.enableAgentMonitor": {
						"type": "boolean",
						"default": false,
						"order": 1,
						"markdownDescription": "エージェント監視を有効にします。ONにするとステータスバーに稼働中エージェントをリアルタイム表示します。\n\n⚠️ **有効にするとPC負荷が若干上がります**（定期的なセッション状態チェックのため）"
					},
					"claudeManager.agentMonitorInterval": {
						"type": "number",
						"default": 5,
						"minimum": 1,
						"maximum": 60,
						"order": 2,
						"markdownDescription": "エージェント監視の更新間隔（秒）。`#claudeManager.enableAgentMonitor#` が有効のときに使用されます。\n\n短くするとリアルタイム性が上がりますが、PC負荷も高まります"
					},
					"claudeManager.enableNotifications": {
						"type": "boolean",
						"default": true,
						"order": 3,
						"description": "タスク完了・エラー・停止時のVS Code通知を有効にする"
					},
					"claudeManager.taskStalledThreshold": {
						"type": "number",
						"default": 60,
						"minimum": 10,
						"maximum": 600,
						"order": 4,
						"description": "stalled判定の閾値（秒）。この時間セッションの更新がないと停止扱い"
					},
					"claudeManager.taskAutoCleanupHours": {
						"type": "number",
						"default": 72,
						"minimum": 1,
						"maximum": 720,
						"order": 5,
						"description": "完了/エラーのタスクログを自動削除するまでの時間（時間）"
					},
					"claudeManager.taskMaxLogs": {
						"type": "number",
						"default": 100,
						"minimum": 10,
						"maximum": 500,
						"order": 6,
						"description": "保持するタスクログの最大件数"
					},
					"claudeManager.enableUsageMonitor": {
						"type": "boolean",
						"default": false,
						"order": 7,
						"markdownDescription": "Claude Code利用制限をステータスバーに表示します。\n\n⚠️ 有効にするとAnthropic APIへの軽量リクエストが定期的に発生します（更新間隔に応じてコスト発生、月額$0.01未満）"
					},
					"claudeManager.usageMonitorInterval": {
						"type": "number",
						"default": 300,
						"minimum": 60,
						"maximum": 3600,
						"order": 8,
						"markdownDescription": "利用制限モニターの更新間隔（秒）。`#claudeManager.enableUsageMonitor#` が有効のときに使用されます"
					}
				}
			},
			{
				"title": "セッション表示",
				"order": 2,
				"properties": {
					"claudeManager.defaultSortMode": {
					"type": "string",
					"default": "updated-desc",
					"enum": ["updated-desc", "updated-asc", "created-desc", "created-asc", "name", "count", "model"],
					"enumDescriptions": [
						"更新日（新しい順）",
						"更新日（古い順）",
						"作成日（新しい順）",
						"作成日（古い順）",
						"名前順",
						"会話件数順",
						"モデル順"
					],
					"description": "セッション一覧のデフォルトのソート順"
				},
				"claudeManager.defaultGroupMode": {
					"type": "string",
					"default": "date",
					"enum": ["date", "tag", "agent", "flat"],
					"enumDescriptions": [
						"日付別",
						"タグ別",
						"エージェント別",
						"グループなし"
					],
					"description": "セッション一覧のデフォルトのグループ化"
				},
				"claudeManager.maxSessionsShown": {
					"type": "number",
					"default": 500,
					"minimum": 10,
					"maximum": 5000,
					"description": "セッション一覧に表示する最大件数。多すぎると動作が重くなる場合があります"
				},
				"claudeManager.sessionFilterMode": {
					"type": "string",
					"default": "all",
					"enum": ["project", "all"],
					"enumDescriptions": [
						"現在のプロジェクトのセッションのみ表示",
						"すべてのセッションを表示"
					],
					"description": "会話一覧のフィルターモード"
				}
				}
			},
			{
				"title": "その他",
				"order": 3,
				"properties": {
					"claudeManager.defaultRuleFolder": {
						"type": "string",
						"default": "",
						"description": "エージェントのルールファイルを格納するフォルダのパス。未設定の場合はsession-manager.jsonのruleFolderを使用します"
					},
					"claudeManager.preview.showThinkingBlocks": {
						"type": "boolean",
						"default": false,
						"description": "Claudeが回答前に内部で考えた思考プロセスをセッションプレビューに表示します"
					},
					"claudeManager.trash.folder": {
						"type": "string",
						"default": "",
