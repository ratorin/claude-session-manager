{
	"name": "claude-session-manager",
	"displayName": "Claude Session Manager - セッション履歴管理",
	"description": "Claude Codeの会話履歴・メモリを管理するVS Code拡張機能",
	"version": "0.5.14",
	"publisher": "ratorin",
	"engines": {
		"vscode": "^1.85.0"
	},
	"icon": "images/icon.png",
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "claude-sessions",
					"title": "💬 セッション",
					"icon": "$(comment-discussion)"
				},
				{
					"id": "claude-agents",
					"title": "👤 エージェント",
					"icon": "$(organization)"
				},
				{
					"id": "claude-memory",
					"title": "🧠 メモリ",
					"icon": "$(database)"
				},
				{
					"id": "claude-projects",
					"title": "📁 プロジェクト",
					"icon": "$(folder-opened)"
				},
				{
					"id": "claude-orchestration",
					"title": "🎼 オーケストレーション",
					"icon": "$(circuit-board)"
				}
			],
			"panel": [
				{
					"id": "claude-help",
					"title": "Claude Help",
					"icon": "$(question)"
				}
			]
		},
		"views": {
			"claude-sessions": [
				{
					"id": "claudeBookmarks",
					"name": "会話ブックマーク",
					"icon": "$(star-full)"
				},
				{
					"id": "claudeTags",
					"name": "会話タグ",
					"icon": "$(tag)"
				},
				{
					"id": "claudeSessions",
					"name": "会話一覧",
					"icon": "$(comment-discussion)"
				}
			],
			"claude-agents": [
				{
					"id": "claudeAgentsLive",
					"name": "ライブ状態",
					"icon": "$(pulse)"
				},
				{
					"id": "claudeAgentsFavorites",
					"name": "お気に入り",
					"icon": "$(star-full)"
				},
				{
					"id": "claudeAgents",
					"name": "エージェント管理",
					"icon": "$(person)"
				}
			],
			"claude-memory": [
				{
					"id": "claudeMemory",
					"name": "メモリ管理",
					"icon": "$(database)"
				}
			],
			"claude-projects": [
				{
					"type": "webview",
					"id": "claudeMain",
					"name": "プロジェクト",
					"icon": "$(folder-opened)"
				}
			],
			"claude-orchestration": [
				{
					"id": "claudeOrchestration",
					"name": "🎼 オーケストレーション",
					"icon": "$(circuit-board)"
				}
			],
			"claude-help": [
				{
					"id": "claudeHelp",
					"name": "ヘルプ & フィードバック",
					"icon": "$(question)"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "claudeAgents",
				"contents": "エージェントが未登録です。\nまずは取締役を登録して、マルチエージェント運用を始めましょう。\n[取締役を登録](command:claudeManager.registerDirector)\n[使い方ガイドを開く](command:claudeManager.openGuide)",
				"when": "!claudeManager.hasAgents"
			},
			{
				"view": "claudeAgentsFavorites",
				"contents": "お気に入りエージェントがありません。\nエージェントリストで ☆ をクリックして追加しましょう。",
				"when": "claudeManager.hasAgents"
			}
		],
		"commands": [
			{
				"command": "claudeManager.removeAllHooks",
				"title": "すべての CSM フックを削除（アンインストール準備）",
				"icon": "$(trash)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.refreshSessions",
				"title": "会話一覧を更新",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.previewSession",
				"title": "会話をプレビュー",
				"icon": "$(eye)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.bookmarkSession",
				"title": "ブックマークに追加",
				"icon": "$(star-empty)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.unbookmarkSession",
				"title": "ブックマークから削除",
				"icon": "$(star-full)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.addAgentFavorite",
				"title": "★ お気に入りに追加",
				"icon": "$(star-empty)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.removeAgentFavorite",
				"title": "★ お気に入りから削除",
				"icon": "$(star-full)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.tagSession",
				"title": "タグを追加",
				"icon": "$(tag)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.removeTag",
				"title": "タグを削除",
				"icon": "$(close)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.renameSession",
				"title": "会話をリネーム",
				"icon": "$(edit)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.searchSessions",
				"title": "会話を検索",
				"icon": "$(search)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.refreshMemory",
				"title": "メモリを更新",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.previewMemory",
				"title": "メモリをプレビュー",
				"icon": "$(eye)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.mergeMemories",
				"title": "メモリを統合",
				"icon": "$(merge)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.extractMemory",
				"title": "メモリから抽出",
				"icon": "$(split-horizontal)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.deleteMemory",
				"title": "メモリを削除",
				"icon": "$(trash)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.editMemory",
				"title": "メモリを編集",
				"icon": "$(edit)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.copySessionId",
				"title": "セッションIDをコピー",
				"icon": "$(copy)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.previewAgent",
				"title": "プレビュー画面を開く",
				"icon": "$(eye)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.previewAgentByName",
				"title": "エージェントプレビュー（名前指定）",
				"icon": "$(eye)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.refreshLiveAgents",
				"title": "ライブ状態を更新",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.showGoals",
				"title": "目標一覧をコピー（/goal PoC）",
				"icon": "$(target)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.refreshOrchestration",
				"title": "オーケストレーション更新",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openSessionInOrchestration",
				"title": "セッション操作",
				"icon": "$(play)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.copyOrchestrationSessionId",
				"title": "セッション ID をコピー",
				"icon": "$(copy)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openOrchestrationSessionInClaude",
				"title": "Claude で開く",
				"icon": "$(play)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.copyAgentSessionId",
				"title": "セッションIDをコピー",
				"icon": "$(copy)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.copyAgentSessionPath",
				"title": "セッションパスをコピー",
				"icon": "$(file-symlink-file)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.registerAgent",
				"title": "エージェントとして登録",
				"icon": "$(person-add)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.editAgent",
				"title": "エージェント設定を編集",
				"icon": "$(edit)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.editRuleFile",
				"title": "ルールファイルを編集",
				"icon": "$(file-code)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.linkSession",
				"title": "セッションを紐づけ",
				"icon": "$(link)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openAgentInClaude",
				"title": "Claudeで開く（IDE）",
				"icon": "$(play)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openAgentSession",
				"title": "ターミナルで開く（ルール適用）",
				"icon": "$(terminal)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.renewAgentSession",
				"title": "セッションを新しくする",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.deleteAgent",
				"title": "エージェントを削除",
				"icon": "$(trash)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.showPendingTasks",
				"title": "確認待ち一覧",
				"icon": "$(checklist)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.refreshAgents",
				"title": "エージェント管理を更新",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openInClaude",
				"title": "Claude Codeで開く",
				"icon": {
					"light": "resources/sparkle-light.svg",
					"dark": "resources/sparkle-dark.svg"
				},
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openOrgChart",
				"title": "組織図を開く",
				"icon": "$(organization)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.checkOrgChartSettings",
				"title": "組織図表示設定を確認",
				"icon": "$(checklist)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openGuide",
				"title": "使い方ガイドを開く",
				"icon": "$(book)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.copySessionPath",
				"title": "セッションパスをコピー",
				"icon": "$(file-symlink-file)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.copyMemoryPath",
				"title": "メモリパスをコピー",
				"icon": "$(file-symlink-file)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.deleteSession",
				"title": "セッションを削除",
				"icon": "$(trash)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.sortSessions",
				"title": "ソート",
				"icon": "$(arrow-swap)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.groupSessions",
				"title": "グループ切替",
				"icon": "$(list-tree)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.registerDirector",
				"title": "取締役を登録",
				"icon": "$(person-add)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.addAgent",
				"title": "エージェントを追加",
				"icon": "$(add)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openSettings",
				"title": "設定を開く",
				"icon": "$(gear)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.reportIssue",
				"title": "不具合を報告（GitHub Issue作成）",
				"icon": "$(bug)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openErrorLog",
				"title": "エラーログを開く",
				"icon": "$(output)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.toggleSessionFilter",
				"title": "プロジェクト/全て切替",
				"icon": "$(filter)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.toggleAgentFilter",
				"title": "他プロジェクトのエージェント表示切替",
				"icon": "$(eye)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.enableSessionAgentInject",
				"title": "エージェント役割自動認識を有効化",
				"icon": "$(sparkle)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openProjectInVSC",
				"title": "VS Codeで開く",
				"icon": "$(folder-opened)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openSettingsFile",
				"title": "設定ファイルを開く",
				"icon": "$(gear)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.refreshUsage",
				"title": "利用制限を更新",
				"icon": "$(refresh)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.openUsageMenu",
				"title": "利用率メニューを開く",
				"icon": "$(dashboard)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.toggleBookmarkFilter",
				"title": "プロジェクト/全て切替",
				"icon": "$(filter)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.toggleMemoryFilter",
				"title": "プロジェクト/全て切替",
				"icon": "$(filter)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.migrateToFolderStructure",
				"title": "フォルダ構造に移行",
				"icon": "$(folder)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.installCsmAskAgent",
				"title": "/csm-ask-agent をインストール",
				"icon": "$(cloud-download)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.installAskAgentHook",
				"title": "/csm-ask-agent hookをインストール（プロジェクト）",
				"icon": "$(shield)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.migrateRuleFiles",
				"title": "ルールファイルを一括移行（YAML + フォルダ構造）",
				"icon": "$(arrow-up)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.syncAllParentRules",
				"title": "配下エージェント情報を一括再生成",
				"icon": "$(sync)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.relocateProject",
				"title": "プロジェクトを移動...",
				"icon": "$(move)",
				"category": "Claude Session Manager"
			},
			{
				"command": "claudeManager.runOrgBuilder",
				"title": "組織診断を実行",
				"icon": "$(organization)",
				"category": "Claude Session Manager"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "claudeManager.refreshSessions",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.searchSessions",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.sortSessions",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.groupSessions",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.openOrgChart",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.openGuide",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.toggleSessionFilter",
					"when": "view == claudeSessions",
					"group": "navigation"
				},
				{
					"command": "claudeManager.openSettings",
					"when": "view == claudeSessions",
					"group": "navigation@999"
				},
				{
					"command": "claudeManager.toggleAgentFilter",
					"when": "view == claudeAgents",
					"group": "navigation"
				},
				{
					"command": "claudeManager.toggleBookmarkFilter",
					"when": "view == claudeBookmarks",
					"group": "navigation"
				},
				{
					"command": "claudeManager.toggleMemoryFilter",
					"when": "view == claudeMemory",
					"group": "navigation"
				},
				{
					"command": "claudeManager.refreshMemory",
					"when": "view == claudeMemory",
					"group": "navigation"
				},
				{
					"command": "claudeManager.addAgent",
					"when": "view == claudeAgents",
					"group": "navigation"
				},
				{
					"command": "claudeManager.showPendingTasks",
					"when": "view == claudeAgents",
					"group": "navigation"
				},
				{
					"command": "claudeManager.refreshAgents",
					"when": "view == claudeAgents",
					"group": "navigation"
				},
				{
					"command": "claudeManager.openOrgChart",
					"when": "view == claudeAgents",
					"group": "navigation"
				},
				{
					"command": "claudeManager.openSettings",
					"when": "view == claudeMain",
					"group": "navigation"
				},
				{
					"command": "claudeManager.refreshOrchestration",
					"when": "view == claudeOrchestration",
					"group": "navigation"
				}
			],
			"view/item/context": [
				
				{
					"command": "claudeManager.previewSession",
					"when": "view == claudeSessions && viewItem =~ /^session/",
					"group": "inline"
				},
				{
					"command": "claudeManager.bookmarkSession",
					"when": "view == claudeSessions && (viewItem == session || viewItem == sessionRegistered)",
					"group": "inline"
				},
				{
					"command": "claudeManager.openInClaude",
					"when": "viewItem =~ /^session/",
					"group": "0_open@1"
				},
				{
					"command": "claudeManager.copySessionId",
					"when": "viewItem =~ /^session/",
					"group": "0_open@3"
				},
				{
					"command": "claudeManager.copySessionPath",
					"when": "viewItem =~ /^session/",
					"group": "0_open@4"
				},
				{
					"command": "claudeManager.renameSession",
					"when": "viewItem =~ /^session/",
					"group": "1_edit@1"
				},
				{
					"command": "claudeManager.tagSession",
					"when": "viewItem =~ /^session/",
					"group": "1_edit@2"
				},
				{
					"command": "claudeManager.registerAgent",
					"when": "viewItem == session || viewItem == sessionBookmarked",
					"group": "2_link@1"
				},
				{
					"command": "claudeManager.editAgent",
					"when": "viewItem == sessionRegistered || viewItem == sessionRegisteredBookmarked",
					"group": "2_link@2"
				},
				{
					"command": "claudeManager.editRuleFile",
					"when": "viewItem == sessionRegistered || viewItem == sessionRegisteredBookmarked",
					"group": "2_link@3"
				},
				{
					"command": "claudeManager.deleteSession",
					"when": "viewItem =~ /^session/",
					"group": "3_danger@1"
				},
				{
					"command": "claudeManager.unbookmarkSession",
					"when": "view == claudeBookmarks && viewItem =~ /Bookmarked/",
					"group": "inline"
				},
				{
					"command": "claudeManager.previewSession",
					"when": "view == claudeBookmarks && viewItem =~ /Bookmarked/",
					"group": "inline"
				},
				{
					"command": "claudeManager.removeTag",
					"when": "view == claudeTags && viewItem == taggedSession",
					"group": "inline"
				},
				
				{
					"command": "claudeManager.addAgentFavorite",
					"when": "view == claudeAgents && viewItem =~ /^agentItem/ && !(viewItem =~ /Bookmarked/)",
					"group": "inline"
				},
				{
					"command": "claudeManager.removeAgentFavorite",
					"when": "(view == claudeAgents || view == claudeAgentsFavorites) && (viewItem =~ /^agentItem.*Bookmarked/ || viewItem =~ /^favoriteAgent/)",
					"group": "inline"
				},
				
				{
					"command": "claudeManager.previewAgent",
					"when": "(view == claudeAgents || view == claudeAgentsFavorites) && viewItem =~ /(agentItemLinked|favoriteAgentLinked)/",
					"group": "0_open@1"
				},
				{
					"command": "claudeManager.openAgentInClaude",
					"when": "(view == claudeAgents || view == claudeAgentsFavorites) && viewItem =~ /(agentItemLinked|favoriteAgentLinked)/",
					"group": "0_open@2"
				},
				{
					"command": "claudeManager.openAgentSession",
					"when": "(view == claudeAgents || view == claudeAgentsFavorites) && viewItem =~ /(agentItemLinked|favoriteAgentLinked)/",
					"group": "0_open@3"
				},
				{
					"command": "claudeManager.renewAgentSession",
					"when": "view == claudeAgents && viewItem =~ /agentItemLinked/",
					"group": "0_open@4"
				},
				{
					"command": "claudeManager.copyAgentSessionId",
					"when": "view == claudeAgents && viewItem =~ /agentItemLinked/",
					"group": "0_open@5"
				},
				{
					"command": "claudeManager.copyAgentSessionPath",
					"when": "view == claudeAgents && viewItem =~ /agentItemLinked/",
					"group": "0_open@6"
				},
				
				{
					"command": "claudeManager.editAgent",
					"when": "view == claudeAgents && viewItem =~ /^agentItem/",
					"group": "1_edit@1"
				},
				{
					"command": "claudeManager.linkSession",
					"when": "view == claudeAgents && viewItem =~ /^agentItem/",
					"group": "2_link@1"
				},
				{
					"command": "claudeManager.deleteAgent",
					"when": "view == claudeAgents && viewItem =~ /^agentItem/",
					"group": "3_danger@1"
				},
				
				{
					"command": "claudeManager.previewMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "inline"
				},
				{
					"command": "claudeManager.copyMemoryPath",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "0_copy"
				},
				{
					"command": "claudeManager.editMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "1_edit"
				},
				{
					"command": "claudeManager.mergeMemories",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "2_actions"
				},
				{
					"command": "claudeManager.extractMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "2_actions"
				},
				{
					"command": "claudeManager.deleteMemory",
					"when": "view == claudeMemory && viewItem == memoryFile",
					"group": "3_danger"
				},
				{
					"command": "claudeManager.openProjectInVSC",
					"when": "view == claudeMemory && viewItem == memoryProject",
					"group": "0_open"
				},
				{
					"command": "claudeManager.openOrchestrationSessionInClaude",
					"when": "view == claudeOrchestration && viewItem =~ /^orchestrationSession/",
					"group": "inline"
				},
				{
					"command": "claudeManager.copyOrchestrationSessionId",
					"when": "view == claudeOrchestration && viewItem =~ /^orchestrationSession/",
					"group": "1_copy"
				},
				{
					"command": "claudeManager.openOrchestrationSessionInClaude",
					"when": "view == claudeOrchestration && viewItem =~ /^orchestrationSession/",
					"group": "0_open"
				}
			]
		},
		"configuration": [
			{
				"title": "エージェント監視",
				"order": 1,
				"properties": {
					"claudeManager.enableAgentMonitor": {
						"type": "boolean",
						"default": true,
						"order": 2,
						"markdownDescription": "エージェント監視を有効にします。ONにするとステータスバーに稼働中エージェントをリアルタイム表示します。\n\n⚠️ **有効にするとPC負荷が若干上がります**（定期的なセッション状態チェックのため）"
					},
					"claudeManager.agentMonitorInterval": {
						"type": "number",
						"default": 5,
						"minimum": 1,
						"maximum": 60,
						"order": 2,
						"markdownDescription": "エージェント監視の更新間隔（秒）。`#claudeManager.enableAgentMonitor#` が有効のときに使用されます。\n\n短くするとリアルタイム性が上がりますが、PC負荷も高まります"
					},
					"claudeManager.enableNotifications": {
						"type": "boolean",
						"default": true,
						"order": 3,
						"description": "タスク完了・エラー・停止時のVS Code通知を有効にする"
					},
					"claudeManager.taskStalledThreshold": {
						"type": "number",
						"default": 60,
						"minimum": 10,
						"maximum": 600,
						"order": 4,
						"description": "stalled判定の閾値（秒）。この時間セッションの更新がないと停止扱い"
					},
					"claudeManager.taskErrorThreshold": {
						"type": "number",
						"default": 1800,
						"minimum": 60,
						"maximum": 7200,
						"order": 4,
						"description": "error判定の閾値（秒）。対話セッションの無操作を誤検知しないよう既定30分。サブエージェント専用に縮めたい場合は600秒などに"
					},
					"claudeManager.taskAutoCleanupHours": {
						"type": "number",
						"default": 72,
						"minimum": 1,
						"maximum": 720,
						"order": 5,
						"description": "完了/エラーのタスクログを自動削除するまでの時間（時間）"
					},
					"claudeManager.taskMaxLogs": {
						"type": "number",
						"default": 100,
						"minimum": 10,
						"maximum": 500,
						"order": 6,
						"description": "保持するタスクログの最大件数"
					},
					"claudeManager.enableUsageMonitor": {
						"type": "boolean",
						"default": true,
						"order": 7,
						"markdownDescription": "Claude Code利用制限をステータスバーに表示します。\n\n⚠️ 有効にするとAnthropic APIへの軽量リクエストが定期的に発生します（更新間隔に応じてコスト発生、月額$0.01未満）"
					},
					"claudeManager.usageMonitorInterval": {
						"type": "number",
						"default": 300,
						"minimum": 60,
						"maximum": 3600,
						"order": 8,
						"markdownDescription": "利用制限モニターの更新間隔（秒）。`#claudeManager.enableUsageMonitor#` が有効のときに使用されます"
					},
					"claudeManager.usage.show5dColumns": {
						"type": "boolean",
						"default": true,
						"order": 9,
						"description": "ステータスバーに Sonnet 5日 / Opus 5日 の利用率列を表示する（S xx% / O xx% 形式）。OFFにすると従来の 5h / 7d 表示のみになります"
					},
					"claudeManager.hooks.desktopNotification.enabled": {
						"type": "boolean",
						"default": false,
						"order": 10,
						"markdownDescription": "セッション終了時にターミナルベル（\\u0007）を発火してデスクトップ通知を行います。\n\n**Claude Code 2.1.141+** の `terminalSequence` 機能を使用します。ターミナルエミュレーターの通知設定も有効にしてください。\n\nOFF がデフォルトです（opt-in）。"
					}
				}
			},
			{
				"title": "セッション表示",
				"order": 2,
				"properties": {
					"claudeManager.defaultSortMode": {
						"type": "string",
						"default": "updated-desc",
						"enum": [
							"updated-desc",
							"updated-asc",
							"created-desc",
							"created-asc",
							"name",
							"count",
							"model"
						],
						"enumDescriptions": [
							"更新日（新しい順）",
							"更新日（古い順）",
							"作成日（新しい順）",
							"作成日（古い順）",
							"名前順",
							"会話件数順",
							"モデル順"
						],
						"description": "セッション一覧のデフォルトのソート順"
					},
					"claudeManager.defaultGroupMode": {
						"type": "string",
						"default": "date",
						"enum": [
							"date",
							"tag",
							"agent",
							"flat"
						],
						"enumDescriptions": [
							"日付別",
							"タグ別",
							"エージェント別",
							"グループなし"
						],
						"description": "セッション一覧のデフォルトのグループ化"
					},
					"claudeManager.maxSessionsShown": {
						"type": "number",
						"default": 500,
						"minimum": 10,
						"maximum": 5000,
						"description": "セッション一覧に表示する最大件数。多すぎると動作が重くなる場合があります"
					},
					"claudeManager.additionalAgentDirs": {
						"type": "array",
						"default": [],
						"items": {
							"type": "string"
						},
						"markdownDescription": "追加でスキャンするプロジェクトフォルダのリスト。各フォルダの `.claude/agents/` 内のエージェント定義を読み込みます。\n\n例: `[\"c:\\\\workspace\\\\CMS\", \"c:\\\\GDrive\"]`"
					},
					"claudeManager.sessionFilterMode": {
						"type": "string",
						"default": "all",
						"enum": [
							"project",
							"all"
						],
						"enumDescriptions": [
							"現在のプロジェクトのセッションのみ表示",
							"すべてのセッションを表示"
						],
						"description": "会話一覧のフィルターモード"
					}
				}
			},
			{
				"title": "その他",
				"order": 3,
				"properties": {
					"claudeManager.preview.showThinkingBlocks": {
						"type": "boolean",
						"default": false,
						"description": "Claudeが回答前に内部で考えた思考プロセスをセッションプレビューに表示します"
					},
					"claudeManager.trash.folder": {
						"type": "string",
						"default": "",
						"description": "削除したセッションの移動先フォルダ。未設定の場合は ~/.claude/.trash/ を使用します"
					},
					"claudeManager.agent.defaultHistoryEnabled": {
						"type": "boolean",
						"default": false,
						"description": "新規エージェント作成時にHISTORY.md（セッション履歴記録）を自動生成する"
					},
					"claudeManager.agent.defaultTodoEnabled": {
						"type": "boolean",
						"default": false,
						"description": "新規エージェント作成時にTODO.md（タスク管理）を自動生成する"
					},
					"claudeManager.agents.showOtherProjects": {
						"type": "boolean",
						"default": true,
						"description": "他プロジェクトのエージェントをエージェント一覧に表示する（灰色で表示）。OFFにすると現在のワークスペースのエージェントのみ表示"
					},
					"claudeManager.agents.defaultExpand": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"default": [
							"bookmarks",
							"recent"
						],
						"description": "エージェントタブで起動時に展開するセクション（bookmarks / recent / global / project）"
					},
					"claudeManager.claudeAgentsIntegration.enabled": {
						"type": "boolean",
						"default": false,
						"description": "廃止予定: claude agents コマンドは TTY 必須のため VS Code 拡張から使用不可。ライブ状態は PID/JSONL 監視 (enableAgentMonitor) で代替。"
					},
					"claudeManager.claudeAgentsIntegration.pollingIntervalMs": {
						"type": "number",
						"default": 5000,
						"minimum": 1000,
						"maximum": 60000,
						"description": "claude agents のポーリング間隔（ミリ秒）。デフォルト: 5000ms"
					},
					"claudeManager.claudeAgentsIntegration.scopeToWorkspace": {
